{
  "name": "digital-second-brain-backend",
  "version": "1.0.0",
  "description": "Backend for Digital Second Brain app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "corpus:build": "node scripts/build-corpus.js",
    "qrels:build": "node scripts/build-qrels.js",
    "splits:build": "node scripts/build-splits.js",
    "bias:analyze": "node scripts/analyze-ground-truth.js",
    "parity:v1": "node scripts/parity-v1.js",
    "eval": "node scripts/run-eval.js",
    "eval:compare": "node scripts/compare-runs.js",
    "holm": "node scripts/holm.js",
    "sweep:v1": "node scripts/sweep-v1.js",
    "sweep:v4": "node scripts/sweep-v4.js",
    "sweep:v6": "node scripts/sweep-v6.js",
    "analyse:bm25": "node scripts/analyse-bm25.js",
    "analyse:v5": "node --expose-gc scripts/analyse-embeddings.js",
    "analyse:v6": "node --expose-gc scripts/analyse-hybrid.js",
    "analyse:rungs": "node scripts/analyse-rungs.js",
    "validate:metrics": "../scripts/.venv/bin/python ../scripts/validate_metrics.py",
    "embed:corpus": "node ../scripts/embed-corpus.js",
    "analyse:vocab": "node scripts/analyse-vocabulary.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^1.1.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.3"
  }
}
