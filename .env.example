# Copy to backend/.env for a local (non-Docker) run:  cp .env.example backend/.env
#
# Docker Compose does NOT read this file, and does not read backend/.env either.
# docker-compose.yml sets PORT, MONGO_URI, JWT_SECRET and JWT_EXPIRE itself, and
# takes GROQ_API_KEY from your shell if you export it.

PORT=5001

# Local Mongo. Under Docker Compose this is mongodb://mongo:27017/... instead.
MONGO_URI=mongodb://localhost:27017/digital_second_brain

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-random-string
JWT_EXPIRE=7d

# https://console.groq.com/keys — optional. Without it the app runs normally and
# only the LLM features return an explicit "Missing GROQ_API_KEY" error.
GROQ_API_KEY=

# Optional. Adds origins to the built-in CORS allowlist; it does not replace it.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
